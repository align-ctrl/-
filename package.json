{
  "name": "align-review",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ALIGN REVIEW - 에이라인치과병원 AI 네이버 리뷰 초안 작성 PWA",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "vite build && wrangler pages dev dist --port 8787 --d1 DB --compatibility-date 2025-09-01",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && wrangler pages dev dist --port 8788 --d1 DB --compatibility-date 2025-09-01",
    "verify": "node scripts/verify-deploy.mjs",
    "test:demo": "node server/demo.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.80.0",
    "pretendard": "^1.3.9",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.32",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.7.0",
    "concurrently": "^10.0.7",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "wrangler": "^4.168.0"
  }
}